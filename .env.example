# Google Calendar prototype (/prototipo) — see README for step-by-step setup.
# Never commit real values. Copy this file to .env.local and fill it in there.

GOOGLE_SERVICE_ACCOUNT_EMAIL=nombre@proyecto.iam.gserviceaccount.com
# Paste the private_key value from the service account's JSON key,
# keeping the \n sequences literal (don't turn them into real line breaks).
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# The calendar to read/write. For a personal Google Calendar this is
# usually your email address; for a secondary calendar, its Calendar ID
# (Calendar settings -> Integrate calendar -> Calendar ID).
GOOGLE_CALENDAR_ID=tuclinica@gmail.com
